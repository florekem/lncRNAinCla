  author = {{Nishiwaki-Matsushima}, Rie and Ohta, Tetsuya and Nishiwaki, Shinji and Suganuma, Masami and Kohyama, Kiyomi and Ishikawa, Takatoshi and Carmichael, Wayne W. and Fujiki, Hirota},
