@article{Melo2014,
  title = {Cancer {{Exosomes Perform Cell}}-{{Independent MicroRNA Biogenesis}} and {{Promote Tumorigenesis}}},
  author = {Melo, Sonia A. and Sugimoto, Hikaru and O'Connell, Joyce T. and Kato, Noritoshi and Villanueva, Alberto and Vidal, August and Qiu, Le and Vitkin, Edward and Perelman, Lev T. and Melo, Carlos A. and Lucci, Anthony and Ivan, Cristina and Calin, George A. and Kalluri, Raghu},
  year = {2014},
  month = nov,
  volume = {26},
  pages = {707--721},
  issn = {1535-6108, 1878-3686},
  doi = {10.1016/j.ccell.2014.09.005},
  abstract = {Exosomes are secreted by all cell types and contain proteins and nucleic acids. Here, we report that breast cancer associated exosomes contain microRNAs (miRNAs) associated with the RISC-Loading Complex (RLC) and display cell-independent capacity to process precursor microRNAs (pre-miRNAs) into mature miRNAs. Pre-miRNAs, along with Dicer, AGO2, and TRBP, are present in exosomes of cancer cells. CD43 mediates the accumulation of Dicer specifically in cancer exosomes. Cancer exosomes mediate an efficient and rapid silencing of mRNAs to reprogram the target cell transcriptome. Exosomes derived from cells and sera of patients with breast cancer instigate nontumorigenic epithelial cells to form tumors in a Dicer-dependent manner. These findings offer opportunities for the development of exosomes based biomarkers and therapies.},
