@article{Li2014c,
  title = {{{MicroRNA}}-9 Regulates Neural Apoptosis in Methylmalonic Acidemia via Targeting {{BCL2L11}}},
  author = {Li, Yanfei and Peng, Tao and Li, Lin and Wang, Xiaohan and Duan, Ranran and Gao, Huili and Guan, Wenjuan and Lu, Jingjing and Teng, Junfang and Jia, Yanjie},
