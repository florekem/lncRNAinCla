  language = {en}
}

@article{Starckx2013,
  title = {Evaluation of {{miR}}-122 and Other Biomarkers in Distinct Acute Liver Injury in Rats.},
  author = {Starckx, Sofie and Batheja, Ameesha and Verheyen, Geert R and Jonghe, Sandra De and Steemans, Kristel and Dijck, Bram Van and Singer, Monica and Bogdan, Nancy and Snoeys, Jan and Vinken, Petra and Sasaki, Jennifer C and Gompel, Jacky Van and {Guzzie-Peck}, Peggy and Lampo, Ann and Lammens, Lieve},
  year = {2013},
  month = jul,
  volume = {41},
  pages = {795--804},
  issn = {1533-1601},
  doi = {10.1177/0192623312464436},
  abstract = {The detection of drug-induced hepatotoxicity remains an important safety issue in drug development. A liver-specific microRNA species, microRNA-122 (miR-122), has recently shown potential for predicting liver injury in addition to the standard hepatic injury biomarkers. The objective of this study was to measure miR-122 together with several other liver markers in distinct settings of acute liver toxicity in rats to determine the value of miR-122 as a biomarker for liver injury in this species. Rats were exposed to 3 well-established liver toxicants (acetaminophen, allyl alcohol, and {$\alpha$}-naphthyl isothiocyanate), a liver-enzyme inducer (phenobarbital), or a cardiotoxicant (doxorubicin). There was a clear increase in plasma miR-122 following administration of acetaminophen, allyl alcohol, and {$\alpha$}-naphthyl isothiocyanate. The response of miR-122 paralleled that of other markers and was consistent with liver injury as indicated by histopathological evaluation. Furthermore, the changes in miR-122 were detected earlier than standard liver injury markers and exhibited a wide dynamic range. In contrast, miR-122 responses to phenobarbital and doxorubicin were low. Based on these findings, miR-122 shows significant promise and may provide added value for assessing liver toxicity in drug development.},
  file = {/home/maciek/Zotero/storage/66MD8987/Starckx et al_2013_Evaluation of miR-122 and other biomarkers in distinct acute liver injury in.pdf},
  journal = {Toxicologic pathology},
  keywords = {acetaminophen,Acetaminophen: toxicity,Acute,Animals,Biological Markers,Biological Markers: blood,Drug-Induced Liver Injury,Drug-Induced Liver Injury: blood,Drug-Induced Liver Injury: genetics,Drug-Induced Liver Injury: pathology,Isocyanates,Isocyanates: toxicity,Liver,Liver: chemistry,Liver: pathology,Male,MicroRNAs,MicroRNAs: blood,Naphthalenes,Naphthalenes: toxicity,Propanols,Propanols: toxicity,Rats,Sprague-Dawley,Toxicity Tests},
  number = {5},
