@article{He2017,
  title = {Comprehensive Investigation of Aberrant {{microRNAs}} Expression in Cells Culture Model of {{MnCl2}}-Induced Neurodegenerative Disease},
  author = {He, Rong and Xie, Xiaoyun and Lv, Linyue and Huang, Yongqi and Xia, Xianmin and Chen, Xiaowu and Zhang, Lei},
  year = {2017},
  month = apr,
  volume = {486},
