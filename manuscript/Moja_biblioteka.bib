  journal = {Comparative biochemistry and physiology. Toxicology \& pharmacology : CBP},
  keywords = {Animals,Bleomycin,Bleomycin: pharmacology,Brain,Brain: metabolism,Cell Cycle Checkpoints,Cell Cycle Checkpoints: drug effects,Cell Line,DNA Damage,gene expression,Gills,Gills: metabolism,Hydroxyurea,Hydroxyurea: pharmacology,Oncorhynchus mykiss,Oncorhynchus mykiss: metabolism,Tumor Suppressor Protein p53,Tumor Suppressor Protein p53: biosynthesis},
