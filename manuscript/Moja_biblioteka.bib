  title = {High-Throughput Amplification of Mature {{microRNAs}} in Uncharacterized Animal Models Using Polyadenylated {{RNA}} and Stem-Loop Reverse Transcription Polymerase Chain Reaction},
  author = {Biggar, Kyle K. and Wu, Cheng-Wei and Storey, Kenneth B.},
