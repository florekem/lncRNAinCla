@article{Squadrito2014,
  title = {Endogenous {{RNAs Modulate MicroRNA Sorting}} to {{Exosomes}} and {{Transfer}} to {{Acceptor Cells}}},
  author = {Squadrito, Mario Leonardo and Baer, Caroline and Burdet, Fr{\'e}d{\'e}ric and Maderna, Claudio and Gilfillan, Gregor D and Lyle, Robert and Ibberson, Mark and De Palma, Michele},
  year = {2014},
  month = aug,
  pages = {1--15},
  issn = {22111247},
  doi = {10.1016/j.celrep.2014.07.035},
  abstract = {MicroRNA (miRNA) transfer via exosomes may mediate cell-to-cell communication. Interestingly, specific miRNAs are enriched in exosomes in a cell-type-dependent fashion. However, the mechanisms whereby miRNAs are sorted to exosomes and the significance of miRNA transfer to acceptor cells are unclear. We used macrophages and endothelial cells (ECs) as a model of heterotypic cell communication in order to investigate both processes. RNA profiling of macrophages and their exosomes shows that miRNA sorting to exosomes is modulated by cell-activation-dependent changes of miRNA target levels in the producer cells. Genetically perturbing the expression of individual miRNAs or their targeted transcripts promotes bidirectional miRNA relocation from the cell cytoplasm/P bodies (sites of miRNA activity) to multivesicular bodies (sites of exosome biogenesis) and controls miRNA sorting to exosomes. Furthermore, the use of Dicer-deficient cells and reporter lentiviral vectors (LVs) for miRNA activity shows that exosomal miRNAs are transferred from macrophages to ECs to detectably repress targeted sequences. \textcopyright{} 2014 The Authors.},
  file = {/home/maciek/Zotero/storage/Q6DCFUSG/Squadrito et al_2014_Endogenous RNAs Modulate MicroRNA Sorting to Exosomes and Transfer to Acceptor.pdf},
  journal = {Cell Reports}
}

