@article{Weirich2014,
  title = {Freshwater Harmful Algal Blooms: Toxins and Children's Health.},
  author = {a Weirich, Chelsea and Miller, Todd R},
  year = {2014},
  month = jan,
  volume = {44},
  pages = {2--24},
