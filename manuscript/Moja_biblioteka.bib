@article{Schageman2013,
  title = {The {{Complete Exosome Workflow Solution}}: {{From Isolation}} to {{Characterization}} of {{RNA Cargo}}, {{The Complete Exosome Workflow Solution}}: {{From Isolation}} to {{Characterization}} of {{RNA Cargo}}},
