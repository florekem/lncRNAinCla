@article{Maughan1989,
  title = {Delayed-Onset Muscle Damage and Lipid Peroxidation in Man after a Downhill Run},
  author = {Maughan, Ronald J. and Donnelly, Alan E. and Gleeson, Michael and Whiting, Paul H. and Walker, Kim A. and Clough, Peter J.},
  year = {1989},
  month = apr,
