@article{Liu2014b,
  title = {Upregulation of {{miR}}-132 Expression in Glioma and Its Clinical Significance},
  author = {Liu, Qiang and Liao, Fan and Wu, Hao and Cai, Tao and Yang, Liang and Wang, Zhi-fei and Zou, Ran},
  year = {2014},
