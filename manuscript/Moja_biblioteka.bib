  author = {Su, Yu Wen and Chen, Xi and Jiang, Zhen Zhou and Wang, Tao and Wang, Cheng and Zhang, Yun and Wen, Jing and Xue, Mei and Zhu, Dan and Zhang, Yue and Su, Yi Jing and Xing, Tong Yue and Zhang, Chen Yu and Zhang, Lu Yong},
  year = {2012},
  month = jan,
  volume = {7},
  pages = {e37395},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0037395},
  abstract = {BACKGROUND: Drug-induced liver injury (DILI) has been a public, economic and pharmaceutical issue for many years. Enormous effort has been made for discovering and developing novel biomarkers for diagnosing and monitoring both clinical and preclinical DILI at an early stage, though progress has been relatively slow. Additionally, herb-induced liver injury is an emerging cause of liver disease because herbal medicines are increasingly being used worldwide. Recently, circulating microRNAs (miRNAs) have shown potential to serve as novel, minimally invasive biomarkers to diagnose and monitor human cancers and other diseases at early stages.\$\textbackslash backslash\$n\$\textbackslash backslash\$nMETHODOLOGY/PRINCIPAL FINDINGS: In order to identify candidate miRNAs as diagnostic biomarkers for DILI, miRNA expression profiles of serum and liver tissue from two parallel liver injury Sprague-Dawley rat models induced by a compound (acetaminophen, APAP) or an herb (Dioscorea bulbifera, DB) were screened in this study. The initial screens were performed on serum using a MicroRNA TaqMan low-density qPCR array and on liver tissue using a miRCURY LNA hybridization array and were followed by a TaqMan probe-based quantitative reverse transcription-PCR (qRT-PCR) assay to validate comparison with serum biochemical parameters and histopathological examination. Two sets of dysregulated miRNA candidates in serum and liver tissue were selected in the screening phase. After qRT-PCR validation, a panel of compound- and herb- related serum miRNAs was identified.\$\textbackslash backslash\$n\$\textbackslash backslash\$nCONCLUSIONS/SIGNIFICANCE: We have demonstrated that this panel of serum miRNAs provides potential biomarkers for diagnosis of DILI with high sensitivity and specificity.},
  file = {/home/maciek/Zotero/storage/C9XDPH24/Su et al_2012_A panel of serum microRNAs as specific biomarkers for diagnosis of compound-.pdf},
  journal = {PLoS ONE},
  keywords = {Animals,Biological Markers,Biological Markers: blood,Cluster Analysis,Dioscorea,Drug-Induced Liver Injury,Drug-Induced Liver Injury: diagnosis,Drug-Induced Liver Injury: pathology,Gene Expression Profiling,Male,Medicinal,Medicinal: adverse effects,Microarray Analysis,MicroRNAs,MicroRNAs: blood,MicroRNAs: diagnostic use,Plants,Rats,Reverse Transcriptase Polymerase Chain Reaction,Sprague-Dawley},
  number = {5},
