  author = {Kumarswamy, Regalla and Bauters, Christophe and Volkmann, Ingo and Maury, Fleur and Fetisch, Jasmin and Holzmann, Angelika and Lemesle, Gilles and de Groote, Pascal and Pinet, Florence and Thum, Thomas},
