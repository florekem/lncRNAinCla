  keywords = {Antisense,Antisense: pharmacology,cholesterol,Cholesterol: metabolism,Endocrine System,Endocrine System: metabolism,Fatty Liver,Fatty Liver: genetics,Fatty Liver: metabolism,Glucose,Glucose: metabolism,Homeostasis,Humans,Insulin,Insulin: metabolism,Lipid Metabolism,Metabolic Diseases,Metabolic Diseases: genetics,Metabolic Diseases: metabolism,Metabolic Syndrome X,Metabolic Syndrome X: genetics,Metabolic Syndrome X: metabolism,MicroRNAs,MicroRNAs: genetics,MicroRNAs: metabolism,Obesity,Obesity: genetics,Obesity: metabolism,Oligoribonucleotides,Signal Transduction,Sterol Regulatory Element Binding Proteins,Sterol Regulatory Element Binding Proteins: geneti,Sterol Regulatory Element Binding Proteins: metabo},
