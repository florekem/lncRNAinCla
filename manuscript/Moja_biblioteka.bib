  author = {Smalheiser, Neil R.},
  year = {2012},
  month = jun,
  volume = {235},
  pages = {455--463},
  issn = {0014-4886},
  doi = {10.1016/j.expneurol.2011.10.015},
  abstract = {A decade ago, RNA interference was proposed to serve as a physiologic means of regulating long-term gene expression in the mammalian brain. However, during the intervening years, this hypothesis appeared to be contradicted by both experimental data and theoretical considerations. More recently, the advent of deep sequencing technology has permitted a re-assessment of this issue. As reviewed here, a large population of small RNAs having features characteristic of endogenous siRNAs are detected within adult mouse hippocampus, which derive from genes involved in synaptic structure and signaling, and which show a significant, though modest (16\textendash 22\%) up-regulation during olfactory discrimination training. Small RNAs derived from abundant cellular noncoding RNAs are also detected; in particular, a subpopulation of RNAs 25\textendash 30 nt. in length shows very large (\&gt; 100 fold) up-regulation during olfactory discrimination training. Preliminary data suggest that the 25\textendash 30 nt. RNAs may associate with MIWI rather than Argonaute 1\textendash 4 homologues. I conclude that, despite their apparent low abundance, endogenous siRNAs and noncoding RNA-derived small RNAs are likely to play an important role in regulating synaptic plasticity.},
  file = {/home/maciek/Zotero/storage/A56P9G3M/Smalheiser_2012_The search for endogenous siRNAs in the mammalian brain.pdf},
  journal = {Experimental Neurology},
  keywords = {Argonaute,Dicer,Gene expression,MicroRNA,MIWI,piRNA,RNA interference,siRNA,Synaptic plasticity},
  number = {2},
  series = {{{MicroRNAs}}\textemdash{{Human Neurobiology}} and {{Neuropathology}}}
}

