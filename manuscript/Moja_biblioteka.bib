@article{Li2014f,
  title = {{{MiR}}-124 Protects Human Hepatic {{L02}} Cells from {{H2O2}}-Induced Apoptosis by Targeting {{Rab38}} Gene.},
  author = {Li, Xiaohua and Yi, Shuhong and Deng, Yinan and Cheng, Jintao and Wu, Xiaocai and Liu, Wei and Tai, Yan and Chen, Guihua and Zhang, Qi and Yang, Yang},
  year = {2014},
  month = jul,
  volume = {450},
  pages = {148--53},
  issn = {1090-2104},
  doi = {10.1016/j.bbrc.2014.05.085},
  abstract = {BACKGROUND: Hepatic ischemia reperfusion injury (IRI) is an inevitable clinical problem for liver surgeons. Because microRNAs (miRNAs) participate in various hepatic pathophysiological processes, this study aimed to explore the role and potential mechanism of miR-124 in hepatic IRI. METHODS: A liver IRI model was established in rats. The differential expression of miRNAs was detected using microarrays, and the expression of miR-124 was measured by qRT-PCR. A hydrogen peroxide (H2O2)-induced oxidative stress apoptosis model was also established. Cell apoptosis was detected by flow cytometry, and viability was detected by CCK8. The expression of Rab38 was detected by Western blotting and qRT-PCR, and a luciferase reporter assay was used to verify the expression of the miR-124 target gene. RESULTS: The miRNA spectrum changes dramatically after hepatic IRI in rats, and miR-124 is significantly down-regulated after liver IRI. MiR-124 decreases the H2O2-induced apoptosis of human hepatic L02 cells by up-regulating the activation of the AKT pathway. Rab38 is a target gene of miR-124 and is involved in H2O2-induced apoptosis. Interference with the expression of the Rab38 gene can protect hepatic L02 from H2O2-induced apoptosis by increasing the phosphorylation of AKT. These protective effects of miR-124 are attenuated by over-expression of Rab38. CONCLUSIONS: Many miRNAs are involved in hepatic IRI in rats, and miR-124 is significantly decreased in this model. MiR-124 significantly decreases the H2O2-induced apoptosis of human hepatic L02 cells by targeting the Rab38 gene and activating the AKT pathway.},
  file = {/home/maciek/Zotero/storage/DEP6M2CW/Li et al_2014_MiR-124 protects human hepatic L02 cells from H2O2-induced apoptosis by.pdf},
  journal = {Biochemical and biophysical research communications},
  keywords = {Animals,Apoptosis,Apoptosis: drug effects,Apoptosis: genetics,Cell Line,Cytoprotection,Cytoprotection: drug effects,Drug Interactions,Gene Targeting,Gene Targeting: methods,Hepatocytes,Hepatocytes: cytology,Hepatocytes: drug effects,Hepatocytes: physiology,Humans,Hydrogen Peroxide,Hydrogen Peroxide: pharmacology,Liver Diseases,Liver Diseases: genetics,Liver Diseases: prevention \& control,Male,MicroRNAs,MicroRNAs: pharmacology,rab GTP-Binding Proteins,rab GTP-Binding Proteins: antagonists \& inhibitors,rab GTP-Binding Proteins: genetics,Rats,Reperfusion Injury,Reperfusion Injury: genetics,Reperfusion Injury: prevention \& control,Sprague-Dawley,Treatment Outcome},
