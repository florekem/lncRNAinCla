@article{Moldovan2014,
  title = {Methodological Challenges in Utilizing {{miRNAs}} as Circulating Biomarkers},
  author = {Moldovan, Leni and Batte, Kara E. and Trgovcich, Joanne and Wisler, Jon and Marsh, Clay B. and Piper, Melissa},
  year = {2014},
