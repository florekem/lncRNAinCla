@article{Ward2012,
  title = {Plasma {{microRNA}} Profiles Distinguish Lethal Injury in Acetaminophen Toxicity: {{A}} Research Study},
  author = {Ward, Jeanine and Bala, Shashi and Petrasek, Jan and Szabo, Gyongyi},
  year = {2012},
  month = jun,
  volume = {18},
  pages = {2798--2804},
  issn = {2219-2840},
  doi = {10.3748/wjg.v18.i22.2798},
  abstract = {AIM: To investigate plasma microRNA (miRNA) profiles indicative of hepatotoxicity in the setting of lethal acetaminophen (APAP) toxicity in mice.\$\textbackslash backslash\$n\$\textbackslash backslash\$nMETHODS: Using plasma from APAP poisoned mice, either lethally (500 mg/kg) or sublethally (150 mg/kg) dosed, we screened commercially available murine microRNA libraries (SABiosciences, Qiagen Sciences, MD) to evaluate for unique miRNA profiles between these two dosing parameters.\$\textbackslash backslash\$n\$\textbackslash backslash\$nRESULTS: We distinguished numerous, unique plasma miRNAs both up- and downregulated in lethally compared to sublethally dosed mice. Of note, many of the greatest up- and downregulated miRNAs, namely 574-5 p, 466 g, 466 f-3p, 375, 29 c, and 148 a, have been shown to be associated with asthma in prior studies. Interestingly, a relationship between APAP and asthma has been previously well described in the literature, with an as yet unknown mechanism of pathology. There was a statistically significant increase in alanine aminotransferase levels in the lethal compared to sublethal APAP dosing groups at the 12 h time point (P {$<$} 0.001). There was 90\% mortality in the lethally compared to sublethally dosed mice at the 48 h time point (P = 0.011).\$\textbackslash backslash\$n\$\textbackslash backslash\$nCONCLUSION: We identified unique plasma miRNAs both up- and downregulated in APAP poisoning which are correlated to asthma development.},
  file = {/home/maciek/Zotero/storage/KGGAB3QZ/Ward et al_2012_Plasma microRNA profiles distinguish lethal injury in acetaminophen toxicity.pdf},
  journal = {World Journal of Gastroenterology},
  keywords = {acetaminophen,Alanine aminotransferase,Drug-Induced Liver Injury,Hepatotoxicity,Plasma microRNA},
  number = {22},
  pmid = {22719188}
}

@article{Wei2008,
