@article{Yang2013,
  title = {{{MicroRNA}} and {{piRNA Profiles}} in {{Normal Human Testis Detected}} by {{Next Generation Sequencing}}},
  author = {Yang, Qingling and Hua, Juan and Wang, Liu and Xu, Bo and Zhang, Huan and Ye, Nan and Zhang, Zhiqiang and Yu, Dexin and Cooke, Howard J. and Zhang, Yuanwei and Shi, Qinghua},
