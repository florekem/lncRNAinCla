@article{Xu2012a,
  title = {Alterations in {{microRNA}} Expression Linked to Microcystin-{{LR}}-Induced Tumorigenicity in Human {{WRL}}-68 {{Cells}}},
  author = {Xu, Lizhi and Qin, Wendi and Zhang, Huan and Wang, Yucai and Dou, Huan and Yu, Decai and Ding, Yitao and Yang, Liuyan and Wang, Yaping},
  year = {2012},
  month = mar,
  volume = {743},
  pages = {75--82},
  issn = {0027-5107},
  doi = {10.1016/j.mrgentox.2011.12.024},
  abstract = {Microcystin-LR (MC-LR) is a cyclic heptapeptide that acts as a potent hepatotoxin and carcinogen. However, the mechanism of its carcinogenic action remains undetermined. In this study, MC-LR was used to induce the malignant transformation of the WRL-68 cell line. Alterations in microRNA (miRNA) expression in the transformed cell were analyzed to determine the role of miRNAs in MC-LR-induced carcinogenesis. Cultured WRL-68 cells (labeled 25MC10) were continuously exposed to a low concentration (10??g/L) of MC-LR for 25 passages. Compared with the mock-treated parental cells, the induced 25MC10 cells exhibited a higher growth rate, resistance to serum-induced terminal differentiation, and tumorigenicity in a nude mouse xenograft test. A pilot miRNA expression array analysis was conducted on the 25MC10 cells, followed by validation of select miRNAs by RT-PCR. We found that the onco-miRNAs miR-21 and miR-221 displayed upregulated expression while the liver-specific miR-122 was downregulated. These results suggest that chronic MC-LR exposure alters the miRNA expression profile of WRL-68 cells and causes phenotypic transformation. We propose that characteristic miRNA alterations could be used as molecular targets for the development of environmental water monitoring methods. ?? 2012 Elsevier B.V.},
  file = {/home/maciek/Zotero/storage/IX66MITA/Xu et al_2012_Alterations in microRNA expression linked to microcystin-LR-induced.pdf},
  journal = {Mutation Research - Genetic Toxicology and Environmental Mutagenesis},
  keywords = {Environmental inspection,Microcystin-LR,MiRNA,Tumorigenicity},
  number = {1-2},
  pmid = {22265967}
}

