  author = {Chen, Fan and Du, Yang and Esposito, Elga and Liu, Yi and Guo, Shuzhen and Wang, Xiaoying and Lo, Eng H. and Xing, Changhong and Ji, Xunming},
  year = {2015},
  month = oct,
