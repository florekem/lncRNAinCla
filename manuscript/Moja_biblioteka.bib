@article{Li2013c,
  title = {Transcription Alterations of {{microRNAs}}, Cytochrome {{P4501A1}} and {{3A65}}, and {{AhR}} and {{PXR}} in the Liver of Zebrafish Exposed to Crude Microcystins},
