@article{Desvignes2015,
  title = {{{miRNA Nomenclature}}: {{A View Incorporating Genetic Origins}}, {{Biosynthetic Pathways}}, and {{Sequence Variants}}},
  shorttitle = {{{miRNA Nomenclature}}},
  author = {Desvignes, T. and Batzel, P. and Berezikov, E. and Eilbeck, K. and Eppig, J. T. and McAndrews, M. S. and Singer, A. and Postlethwait, J. H.},
