@article{Wang2013a,
  title = {Distribution of Microcystin-{{LR}} to Testis of Male {{Sprague}}-{{Dawley}} Rats.},
  author = {Wang, Lihui and Wang, Xueting and Geng, Zhirong and Zhou, Yuan and Chen, Yu and Wu, Jiang and Han, Xiaodong},
