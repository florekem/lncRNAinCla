  doi = {10.1093/nar/gkv115},
  abstract = {The chain of events leading from a toxic compound exposure to carcinogenicity is still barely understood. With the emergence of high-throughput sequencing, it is now possible to discover many different biological components simultaneously. Using two different RNA libraries, we sequenced the complete transcriptome of human HepG2 liver cells exposed to benzo[a]pyrene, a potent human carcinogen, across six time points. Data were integrated in order to reveal novel complex chemical\textendash gene interactions. Notably, we hypothesized that the inhibition of MGMT, a DNA damage response enzyme, by the over-expressed miR-181a-1\_3p induced by BaP, may lead to liver cancer over time.},
