@article{Carmel2001,
  title = {Gene Expression Profiling of Acute Spinal Cord Injury Reveals Spreading Inflammatory Signals and Neuron Loss},
  author = {Carmel, J. B. and Galante, A. and Soteropoulos, P. and Tolias, P. and Recce, M. and Young, W. and Hart, R. P.},
